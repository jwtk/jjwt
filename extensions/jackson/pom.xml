<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-root</artifactId>
        <version>0.14.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jjwt-jackson</artifactId>
    <name>JJWT :: Extensions :: Jackson</name>
    <packaging>jar</packaging>

    <properties>
        <jjwt.root>${basedir}/../..</jjwt.root>
        <!-- Jackson 3 requires Java 17, so this is the one JJWT module that does not target Java 8.
             Applications on Java 8 through 16 use jjwt-jackson2 (or jjwt-gson / jjwt-orgjson) instead. -->
        <jdk.release.version>17</jdk.release.version>
        <jdk.version>17</jdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- This module's classes are Java 17 bytecode and cannot be loaded by the JDK 8 and 11 legs of
                         the multi-JDK test matrix (see the jdk-8 and jdk-11 profiles in the root pom): -->
                    <execution>
                        <id>test-jdk-8</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-jdk-11</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <parameter>
                        <!-- jjwt-jackson releases before 0.14.0 were compiled against Jackson 2, which is not on
                             this module's classpath, so japicmp cannot load every class they reference.
                             TODO: remove when jjwt.previousVersion is 0.14.0 or later. -->
                        <ignoreMissingClasses>true</ignoreMissingClasses>
                    </parameter>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
